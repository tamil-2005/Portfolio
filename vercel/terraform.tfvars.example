# Vercel API Token (Generate from Vercel Account Settings > Tokens)
vercel_api_token = "your-vercel-api-token-here"

# Vercel Team ID (Optional: leave null if using personal account)
# vercel_team_id = "team_xxxxxx"

# Project Name
project_name = "tamilselvan-portfolio"

# Git Repository Integration (Optional: connect GitHub repo directly to Vercel)
# git_repository = {
#   type = "github"
#   repo = "your-username/pro-portfolio"
# }

# Custom Domain (Optional: e.g. portfolio.yourdomain.com)
# custom_domain = "tamilselvan.dev"
